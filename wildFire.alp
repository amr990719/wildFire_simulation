		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1780665760103">
			<Id>1780944309749</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<AdditionalClassCode><![CDATA[StringBuilder results;]]></AdditionalClassCode>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[results = new StringBuilder();]]></InitialSetupCode>
			<MaximumMemory>4096</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[int landscape = (int) root.landscapeSeed;
double[] fuel = root.generateFuelArray(landscape);

java.util.Random picker = new java.util.Random(landscape);   // reproducible points
int N = root.N, total = N*N;

for (int p = 0; p < 100; p++) {
    int ign = picker.nextInt(total);
    long fireSeed = landscape * 1000L + p;
    int burned = root.simulateOneFire(ign, fuel, fireSeed);
    results.append(landscape + "," + p + "," + ign + "," + burned + "\n");
}]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs><![CDATA[]]></VmArgs>
			<LoadRootFromSnapshot>false</LoadRootFromSnapshot>


			<AfterExperimentCode><![CDATA[try {
    java.io.PrintWriter pw = new java.io.PrintWriter("fire_sizes.csv");
    pw.print("landscape,ignitionPoint,ignitionIndex,burnedOutCells\n");
    pw.print(results.toString());
    pw.close();
    traceln("Written: " + new java.io.File("fire_sizes.csv").getAbsolutePath());
} catch (Exception e) { traceln("Write failed: " + e); }]]></AfterExperimentCode>
