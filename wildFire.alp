			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1780732437859</Id>
					<Name><![CDATA[makeInitialFuel]]></Name>
					<X>180</X><Y>20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ---- 1. Plant forest "seeds" and grow forests around them ----
for (int n = 0; n < 200; n++) {                 // 200 forest seeds
    int x = uniform_discr(0, N - 1);            // random seed location
    int y = uniform_discr(0, N - 1);
    for (int k = 0; k < 1000; k++) {            // 1000 fuel deposits per seed
        int i = ((int) triangular(-50, 0, 50) + x + N) % N;   // near the seed
        int j = ((int) triangular(-50, 0, 50) + y + N) % N;
        gridcells.get(i * N + j).Fuel += 0.25;
    }
}

// ---- 2. Smooth the landscape (two-pass: read into temp, then write back) ----
double[] smoothed = new double[gridcells.size()];
int idx = 0;
for (GridCell gc : gridcells) {
    double sum = gc.Fuel;                 // include the cell itself
    int count = 1;
    for (GridCell nb : gc.gridNeighbors()) {
        sum += nb.Fuel;
        count++;
    }
    smoothed[idx++] = sum / count;
}
idx = 0;
for (GridCell gc : gridcells)
    gc.Fuel = smoothed[idx++];

// ---- 3. Find the min and max fuel across all cells ----
double min = Double.POSITIVE_INFINITY;
double max = Double.NEGATIVE_INFINITY;
for (GridCell gc : gridcells) {
    double f = gc.Fuel;
    if (f > max) max = f;
    if (f < min) min = f;
}

// ---- 4. Normalize every cell's fuel into the range [-0.2, 1.3] ----
for (GridCell gc : gridcells) {
    gc.Fuel -= min;                  // shift to [0 .. max-min]
    gc.Fuel *= 1.5 / (max - min);    // scale to [0 .. 1.5]
    gc.Fuel -= 0.2;                  // shift to [-0.2 .. 1.3]
}

// ---- 5. Color each cell to reflect its fuel ----
for (GridCell gc : gridcells) {
    gc.rectangle.setFillColor(
        lerpColor(gc.Fuel, paleGoldenRod, new Color(65, 100, 0))
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1780943823367</Id>
					<Name><![CDATA[generateFuelArray]]></Name>
					<X>290</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[seed]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// returns a fuel array of size N*N, generated reproducibly from 'seed'
int N = this.N;
int total = N * N;
double[] fuel = new double[total];
java.util.Random rng = new java.util.Random(seed);

// 1. forest seeds
for (int n = 0; n < 200; n++) {
    int x = rng.nextInt(N);
    int y = rng.nextInt(N);
    for (int k = 0; k < 1000; k++) {
        // triangular-ish offset around (x,y), range ~[-50,50] peaked at 0
        int oi = (int)((rng.nextDouble() + rng.nextDouble() - 1) * 50);
        int oj = (int)((rng.nextDouble() + rng.nextDouble() - 1) * 50);
        int i = ((oi + x) % N + N) % N;
        int j = ((oj + y) % N + N) % N;
        fuel[i * N + j] += 0.25;
    }
}

// 2. smooth once
double[] smoothed = new double[total];
for (int i = 0; i < N; i++)
    for (int j = 0; j < N; j++) {
        double sum = 0; int cnt = 0;
        for (int di = -1; di <= 1; di++)
            for (int dj = -1; dj <= 1; dj++) {
                int ni = i + di, nj = j + dj;
                if (ni>=0 && ni<N && nj>=0 && nj<N) { sum += fuel[ni*N+nj]; cnt++; }
            }
        smoothed[i*N+j] = sum / cnt;
    }
fuel = smoothed;

// 3. min/max
double min = Double.POSITIVE_INFINITY, max = Double.NEGATIVE_INFINITY;
for (double f : fuel) { if (f>max) max=f; if (f<min) min=f; }

// 4. normalize to [-0.2, 1.3]
for (int i = 0; i < total; i++) {
    fuel[i] -= min;
    fuel[i] *= 1.5 / (max - min);
    fuel[i] -= 0.2;
}
return fuel;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1780944003019</Id>
					<Name><![CDATA[simulateOneFire]]></Name>
					<X>430</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ignIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fuel]]></Name>
						<Type><![CDATA[double[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[seed]]></Name>
						<Type><![CDATA[long]]></Type>
					</Parameter>
					<Body><![CDATA[int N = this.N;
int total = N * N;
boolean[] burned = new boolean[total];
java.util.Random rng = new java.util.Random(seed);
java.util.ArrayDeque<Integer> active = new java.util.ArrayDeque<Integer>();

if (fuel[ignIndex] > 0) { burned[ignIndex] = true; active.add(ignIndex); }

while (!active.isEmpty()) {
    int cell = active.poll();
    int r = cell / N, c = cell % N;

    // number of spread events for this cell ~ Poisson(rate * burnTime) = Poisson(5 * Fuel)
    // matches the statechart: SpreadFire rate 5, burn duration = Fuel
    double lambda = 3.0 * fuel[cell];
    int attempts = poissonSample(lambda, rng);

    for (int attempt = 0; attempt < attempts; attempt++) {
        for (int di = -1; di <= 1; di++)
            for (int dj = -1; dj <= 1; dj++) {
                if (di == 0 && dj == 0) continue;
                int nr = r + di, nc = c + dj;
                if (nr < 0 || nr >= N || nc < 0 || nc >= N) continue;
                int nIdx = nr * N + nc;
                if (!burned[nIdx] && fuel[nIdx] > 0 && rng.nextDouble() < 0.2) {
                    burned[nIdx] = true;
                    active.add(nIdx);
                }
            }
    }
}

int count = 0;
for (boolean b : burned) if (b) count++;
return count;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1780989399974</Id>
					<Name><![CDATA[poissonSample]]></Name>
					<X>570</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lambda]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rng]]></Name>
						<Type><![CDATA[java.util.Random]]></Type>
					</Parameter>
					<Body><![CDATA[// Knuth's algorithm for sampling from a Poisson distribution
if (lambda <= 0) return 0;
double L = Math.exp(-lambda);
int k = 0;
double p = 1.0;
do {
    k++;
    p *= rng.nextDouble();
} while (p > L);
return k - 1;]]></Body>
				</Function>
