			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[List<GridCell>]]></ReturnType>
					<Id>1780740445445</Id>
					<Name><![CDATA[gridNeighbors]]></Name>
					<X>95</X><Y>-15</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.List<GridCell> result = new java.util.ArrayList<GridCell>();
int N = main.N;                                  // or 200 if no N parameter
int r = getR();
int c = getC();
for (int di = -1; di <= 1; di++) {
    for (int dj = -1; dj <= 1; dj++) {
        if (di == 0 && dj == 0) continue;            // skip self
        int ni = r + di, nj = c + dj;
        if (ni >= 0 && ni < N && nj >= 0 && nj < N)  // skip off-grid
            result.add(main.gridcells.get(ni * N + nj));
    }
}
return result;]]></Body>
				</Function>
			</Functions>
